---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" id="favicon" type="image/png" href="/favicon-dark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        function faviconFor(theme) {
          return theme === "light" ? "/favicon-light.png" : "/favicon-dark.png";
        }
        function applyFavicon(theme) {
          var link = document.getElementById("favicon");
          if (link) link.setAttribute("href", faviconFor(theme));
        }
        window.__setFavicon = applyFavicon;
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          applyFavicon(theme);
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
          applyFavicon("dark");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-to-content" href="#main">Skip to main content</a>
    <ThemeToggle />
    <div class="page">
      <slot />
    </div>
  </body>
</html>
