---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import TypedHero from "../components/TypedHero.astro";
import LinkList from "../components/LinkList.astro";
import SectionHead from "../components/SectionHead.astro";
import Socials from "../components/Socials.astro";
import { getSiteData, renderProfile } from "../lib/site";

const { profile, writing, research, researchIntro, socials } = await getSiteData();
const { Content } = await renderProfile();
const { name, tagline, linkedin, substack, scholar, previous } = profile.data;
---

<Layout title={name} description={tagline}>
  <main id="main">
    <div class="hero">
      <Avatar src="/tanmay.jpeg" alt="Portrait of Tanmay Ghai" />
      <TypedHero name={name} tagline={tagline} previous={previous} />
    </div>

    <section id="about" aria-label="About">
      <SectionHead id="about" title="About" icon="user" actionHref={linkedin} actionLabel="LinkedIn" />
      <div class="markdown">
        <Content />
      </div>
    </section>

    <section id="research" aria-label="Research">
      <SectionHead id="research" title="Research" icon="layers" actionHref={scholar} actionLabel="Scholar" />
      {
        researchIntro && (
          <div class="markdown">
            <researchIntro.Content />
          </div>
        )
      }
      {
        research.length > 0 && (
          <h3 class="subhead" id="selected-publications">
            <span class="seg">Selected publications</span>
          </h3>
        )
      }
      <LinkList items={research} empty="Nothing listed here yet." bulleted />
    </section>

    <section id="writing" aria-label="Writing">
      <SectionHead id="writing" title="Writing" icon="pen" actionHref={substack} actionLabel="Substack" />
      <LinkList items={writing} empty="Nothing published here yet." />
    </section>
  </main>

  <Socials links={socials} />
</Layout>
