---
import Icon from "./Icon.astro";
import type { Social } from "../lib/site";

interface Props {
  links: Social[];
}

const { links } = Astro.props;
---

<footer>
  {
    links.map((link) => (
      <a class="btn" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
        <Icon name={link.icon} size={16} />
      </a>
    ))
  }
</footer>
