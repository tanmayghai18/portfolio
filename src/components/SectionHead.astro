---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  title: string;
  icon: "doc" | "pen" | "music" | "layers";
  actionHref?: string;
  actionLabel?: string;
  actionExternal?: boolean;
}

const { id, title, icon, actionHref, actionLabel, actionExternal = true } = Astro.props;
---

<div class="section-head">
  <h2>
    <Icon name={icon} />
    <a class="seg" href={`#${id}`}>{title}</a>
  </h2>
  {
    actionHref && actionLabel && (
      <a
        class="link ext"
        href={actionHref}
        target={actionExternal ? "_blank" : undefined}
        rel={actionExternal ? "noopener noreferrer" : undefined}
      >
        {actionLabel}
        <span class="ext-arrow" aria-hidden="true">↗</span>
      </a>
    )
  }
</div>
